# Per-machine ROS settings. Copy to config/local.env (gitignored) and uncomment what this
# machine needs. scripts/set_ros_env.sh reads it on every pixi activation.
#
# Plain KEY=value lines and whole-line comments only: no `export`, no $VARIABLES, no
# trailing comments. A variable already set in your shell wins over this file.
# Unset keys fall back to ROS_DOMAIN_ID=5 and RMW_IMPLEMENTATION=rmw_fastrtps_cpp with no
# Fast DDS profile.

# ROS_DOMAIN_ID=5

# rmw_fastrtps_cpp or rmw_cyclonedds_cpp
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# DFKI robot PC only: loopback + camera link, unicast discovery for domain 5. A path
# relative to the workspace root (see config/fastdds_config.xml).
# FASTRTPS_DEFAULT_PROFILES_FILE=config/fastdds_config.xml
